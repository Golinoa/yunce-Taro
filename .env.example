# 云策教务前端环境变量清单
# 用法：复制为 .env 或构建时通过 shell 传入；Taro 在构建期读取 process.env.* 注入到产物。

# 是否启用前端 Mock 数据（默认 false，生产安全）
#   - 开发 / 演示：设为 true 启用本地 mock（无需后端即可跑通页面）
#   - 生产 / 正式联调：设为 false 走真实接口（微信一键登录 + 手机号注册）
# 注意：生产构建若误带 VITE_USE_MOCK=true 会被 config/index.ts 的 G-01 守卫强制关闭。
VITE_USE_MOCK=false

# 真实接口基础路径（开发工具可填完整 URL；生产由 CI 覆盖）
# 示例：http://localhost:3000/api/app/v1 或 https://api.chancore.cn/api/app/v1
TARO_API_BASE_URL=http://localhost:3000/api/app/v1

# --- 订阅消息联调（后端 HTTP P0 就绪后）---
# VITE_USE_MOCK=false
# 真机微信面板需后端 SUBSCRIBE_TMPL_* 配好真实 tmplId 并重启；未配时前端会跳过 requestSubscribeMessage
# 可先验：bootstrap / auth-report / pending consume+dismiss

# 是否开启本地调试日志（默认 false；开启后会输出路由守卫 / 接口调用等调试信息）
TARO_ENABLE_LOCAL_DEBUG=false
