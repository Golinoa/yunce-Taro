/**
 * 卡种会员列表页
 *
 * 从卡种管理卡片底部统计区域进入，展示某个卡种在指定维度下的会员卡列表。
 * - 已售 / 在用 / 用完 / 未开卡 / 冻卡/停卡
 * - 点击学员卡片进入学员详情页
 */
import { View, Text, ScrollView, Image } from '@tarojs/components';
import Taro, { useDidShow } from '@tarojs/taro';
import cn from 'classnames';
import React, { useCallback, useEffect, useMemo, useState } from 'react';
import Card from '@/components/Card';
import Empty from '@/components/Empty';
import Loading from '@/components/Loading';
import PageContainer from '@/components/PageContainer';
import { memberCardService } from '@/services/member-card';
import type { CardTypeStatKey, MemberCard } from '@/types/member-card';
import { CARD_TYPE_STAT_LABELS } from '@/types/member-card';
import { withRouteGuard } from '@/utils/route-guard';

/** 金额格式化（分 → 元） */
const formatPrice = (priceInCent: number): string => {
  return (priceInCent / 100).toLocaleString('zh-CN', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
};

const STATUS_TAG_MAP: Record<MemberCard['status'], { label: string; color: string }> = {
  active: { label: '在用', color: 'text-success bg-success/10' },
  inactive: { label: '停用', color: 'text-muted-foreground bg-muted' },
  usedUp: { label: '用完', color: 'text-muted-foreground bg-muted' },
  notActivated: { label: '未开卡', color: 'text-warning bg-warning/10' },
  frozen: { label: '冻卡', color: 'text-info bg-info/10' },
};

/** 页面入口参数 */
interface PageParams {
  cardTypeId: string;
  cardTypeName: string;
  stat: CardTypeStatKey;
}

const CardMemberListPage: React.FC = () => {
  const params = useMemo<PageParams>(() => {
    const routerParams = Taro.getCurrentInstance()?.router?.params || {};
    return {
      cardTypeId: decodeURIComponent(routerParams.cardTypeId || ''),
      cardTypeName: decodeURIComponent(routerParams.cardTypeName || ''),
      stat: (decodeURIComponent(routerParams.stat || '') as CardTypeStatKey) || 'sold',
    };
  }, []);

  const [list, setList] = useState<MemberCard[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  const statLabel = CARD_TYPE_STAT_LABELS[params.stat];
  const navigationTitle = `${params.cardTypeName} | ${statLabel}`;

  const loadData = useCallback(async () => {
    if (!params.cardTypeId) return;
    setLoading(true);
    setError('');
    try {
      const data = await memberCardService.getListByCardType(params.cardTypeId, params.stat);
      setList(data);
    } catch {
      setError('加载失败，请重试');
    } finally {
      setLoading(false);
    }
  }, [params.cardTypeId, params.stat]);

  useEffect(() => {
    Taro.setNavigationBarTitle({ title: navigationTitle });
    void loadData();
  }, [loadData, navigationTitle]);

  useDidShow(() => {
    void loadData();
  });

  const handleMemberClick = useCallback((studentId: string) => {
    if (!studentId) return;
    Taro.navigateTo({ url: `/package-student/pages/student-detail/index?id=${studentId}` });
  }, []);

  const totalSales = useMemo(
    () => list.reduce((sum, item) => sum + (item.purchasePrice || 0), 0),
    [list],
  );

  return (
    <PageContainer className="bg-background">
      <ScrollView scrollY className="h-full px-[32rpx] py-[24rpx]">
        {/* 顶部统计摘要 */}
        <Card className="p-[32rpx] mb-[24rpx]">
          <Text className="text-[36rpx] font-bold text-foreground">{params.cardTypeName}</Text>
          <Text className="mt-[8rpx] text-[28rpx] text-muted-foreground">
            {statLabel}（{list.length}张）
          </Text>
          <View className="mt-[20rpx] inline-flex flex-row items-center px-[20rpx] py-[10rpx] rounded-[12rpx] bg-muted">
            <Text className="text-[26rpx] text-muted-foreground">总销售额 </Text>
            <Text className="text-[26rpx] font-bold text-foreground ml-[8rpx]">
              ¥{formatPrice(totalSales)}
            </Text>
          </View>
        </Card>

        {/* 会员卡列表 */}
        {loading && list.length === 0 ? (
          <Loading text="加载中..." />
        ) : error && list.length === 0 ? (
          <Empty description={error} actionText="重新加载" onAction={() => void loadData()} />
        ) : list.length === 0 ? (
          <Empty description={`暂无${statLabel}记录`} />
        ) : (
          <View className="flex flex-col gap-[24rpx]">
            {list.map((item) => (
              <MemberCardItem
                key={item.id}
                data={item}
                onClick={() => handleMemberClick(item.studentId)}
              />
            ))}
          </View>
        )}
      </ScrollView>
    </PageContainer>
  );
};

/** 单条会员卡记录卡片 */
const MemberCardItem: React.FC<{ data: MemberCard; onClick: () => void }> = ({ data, onClick }) => {
  const statusTag = STATUS_TAG_MAP[data.status];

  return (
    <Card className="p-[28rpx] press-scale" onClick={onClick}>
      {/* 第一行：头像 + 姓名 + 状态 */}
      <View className="flex flex-row items-center gap-[20rpx]">
        <Image
          className="w-[88rpx] h-[88rpx] rounded-full bg-muted"
          src={data.studentAvatar || ''}
          mode="aspectFill"
          lazyLoad
        />
        <View className="flex-1 min-w-0 flex flex-col gap-[8rpx]">
          <Text className="text-[32rpx] font-medium text-foreground">{data.studentName}</Text>
          <Text className="text-[24rpx] text-muted-foreground">{data.studentPhone || '-'}</Text>
        </View>
        <View className={cn('px-[16rpx] py-[6rpx] rounded-[12rpx]', statusTag.color)}>
          <Text className="text-[22rpx] font-medium whitespace-nowrap">{statusTag.label}</Text>
        </View>
      </View>

      {/* 剩余次数/天数 */}
      <View className="mt-[24rpx] p-[24rpx] rounded-[16rpx] bg-muted/50">
        <Text className="text-[40rpx] font-bold text-foreground">
          {data.remainingCount !== undefined
            ? `${data.remainingCount}次`
            : `${data.remainingDays || 0}天`}
        </Text>
        <Text className="mt-[4rpx] text-[24rpx] text-muted-foreground">剩余次数</Text>
      </View>

      {/* 时间信息 */}
      <View className="mt-[24rpx] flex flex-row items-center justify-between">
        <View className="flex flex-col items-center flex-1">
          <Text className="text-[24rpx] text-muted-foreground">购买时间</Text>
          <Text className="mt-[8rpx] text-[26rpx] text-foreground">{data.purchaseAt}</Text>
        </View>
        <View className="flex flex-col items-center flex-1">
          <Text className="text-[24rpx] text-muted-foreground">开卡时间</Text>
          <Text className="mt-[8rpx] text-[26rpx] text-foreground">{data.activatedAt || '-'}</Text>
        </View>
        <View className="flex flex-col items-center flex-1">
          <Text className="text-[24rpx] text-muted-foreground">到期时间</Text>
          <Text className="mt-[8rpx] text-[26rpx] text-foreground">{data.expiredAt || '-'}</Text>
        </View>
      </View>

      {/* 底部信息 */}
      <View className="mt-[24rpx] pt-[20rpx] border-t border-border flex flex-row items-center justify-between">
        <Text className="text-[24rpx] text-muted-foreground">
          冻卡：{data.frozenCount}/{data.remainingCount ?? 0}次，{data.frozenDays}/
          {data.remainingDays ?? 0}天
        </Text>
        <View className="flex flex-row items-center">
          <Text className="text-[24rpx] text-muted-foreground">购买价</Text>
          <Text className="ml-[8rpx] text-[28rpx] font-bold text-error">
            ¥{formatPrice(data.purchasePrice)}
          </Text>
        </View>
      </View>

      {/* 开卡来源 */}
      {data.source && (
        <Text className="mt-[16rpx] text-[24rpx] text-muted-foreground">开卡：{data.source}</Text>
      )}
    </Card>
  );
};

// eslint-disable-next-line import/no-named-as-default-member
definePageConfig({
  navigationBarTitleText: '会员卡列表',
  navigationBarBackgroundColor: '#FFFFFF',
  navigationBarTextStyle: 'black',
});

export default withRouteGuard(CardMemberListPage);
