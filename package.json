{
  "name": "yunce-edu",
  "version": "1.0.0",
  "private": true,
  "description": "云策教务 - 教务管理小程序",
  "templateInfo": {
    "name": "react",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp && node scripts/postbuild-weapp-fixes.mjs && node scripts/verify-shared-modules.mjs",
    "build:weapp:mock": "node -e \"console.error('[removed] build:weapp:mock 已废弃，请用 npm run build:weapp:dev'); process.exit(1)\"",
    "dev:weapp:mock": "node -e \"console.error('[removed] dev:weapp:mock 已废弃，请用 npm run dev:weapp:dev'); process.exit(1)\"",
    "generate:mock-stubs": "node -e \"console.error('[removed] generate:mock-stubs 已废弃（src/data 已删除）'); process.exit(1)\"",
    "build:weapp:prod": "node scripts/build-weapp-prod.mjs",
    "build:weapp:dev": "node scripts/build-weapp-dev.mjs",
    "build:weapp:clean": "node scripts/clean-weapp-cache.mjs && taro build --type weapp && node scripts/postbuild-weapp-fixes.mjs && node scripts/verify-shared-modules.mjs",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:quickapp": "taro build --type quickapp",
    "optimize:images": "node scripts/optimize-images.mjs",
    "dev:weapp": "node scripts/dev-weapp.mjs",
    "dev:weapp:dev": "node scripts/dev-weapp-dev.mjs",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "npm run build:rn -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:quickapp": "npm run build:quickapp -- --watch",
    "prepare": "husky",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss,css,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "upload:weapp": "node scripts/upload-weapp.mjs"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.21.5",
    "@mdi/js": "^7.4.47",
    "@tarojs/components": "4.1.9",
    "@tarojs/helper": "4.1.9",
    "@tarojs/plugin-framework-react": "4.1.9",
    "@tarojs/plugin-html": "4.1.9",
    "@tarojs/plugin-platform-alipay": "4.1.9",
    "@tarojs/plugin-platform-h5": "4.1.9",
    "@tarojs/plugin-platform-tt": "4.1.9",
    "@tarojs/plugin-platform-weapp": "4.1.9",
    "@tarojs/react": "4.1.9",
    "@tarojs/runtime": "4.1.9",
    "@tarojs/shared": "4.1.9",
    "@tarojs/taro": "4.1.9",
    "ajv": "^8.20.0",
    "classnames": "^2.5.0",
    "dayjs": "^1.11.10",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "uqrcodejs": "^4.0.7",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.8.0",
    "@babel/plugin-proposal-class-properties": "7.14.5",
    "@babel/preset-react": "^7.24.1",
    "@iconify-json/mdi": "^1.2.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "4.1.9",
    "@tarojs/taro-loader": "4.1.9",
    "@tarojs/webpack5-runner": "4.1.9",
    "@types/node": "^18.15.11",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "@unocss/preset-icons": "^66.7.0",
    "@unocss/webpack": "^66.7.0",
    "@vitest/coverage-v8": "^2.1.8",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "4.1.9",
    "eslint": "^8.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-taro": "4.1.9",
    "eslint-plugin-import": "^2.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.8.2",
    "eslint-plugin-react-hooks": "^4.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "minidev": "^2.2.5",
    "miniprogram-ci": "^2.1.26",
    "postcss": "^8.4.18",
    "prettier": "^3.8.4",
    "react-refresh": "^0.11.0",
    "sharp": "^0.35.2",
    "stylelint": "^14.4.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths-webpack-plugin": "^4.0.1",
    "tt-ide-cli": "^0.1.31",
    "typescript": "^5.1.0",
    "unocss": "^66.7.0",
    "unocss-applet": "^0.12.2",
    "vitest": "^2.1.8",
    "webpack": "5.78.0"
  },
  "engines": {
    "node": "24.20.0"
  }
}
